# The Gradle wrapper JAR is a binary that the Flutter tool re-injects from its
# own SDK cache on first build (see injectGradleWrapperIfNeeded), so it is not
# stored in the repository.
/gradle/wrapper/gradle-wrapper.jar
/gradlew
/gradlew.bat

